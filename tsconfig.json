{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  // apps/ui 有自己的 tsconfig（含 DOM lib 与 react-jsx），不并入根工程
  "include": [
    "apps/api/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "apps/api/test/**/*.ts",
    "packages/*/test/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["apps/ui", "node_modules"]
}

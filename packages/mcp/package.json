{
  "name": "@agentssignal/mcp",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "bin": {
    "agentsignal-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@agentssignal/* --external:zod --outfile=dist/index.js"
  },
  "description": "@agentssignal/mcp — MCP stdio server：五工具 1:1 镜像 REST（list/query/use/publish/report）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embaobao/agentsignal.git"
  },
  "author": "AgentSignal",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  }
}

{
  "name": "@agentssignal/cli",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "bin": {
    "agentsignal": "./dist/index.js"
  },
  "dependencies": {
    "@agentssignal/protocol": "workspace:*"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@agentssignal/* --external:zod --outfile=dist/index.js"
  },
  "description": "@agentssignal/cli — agentsignal CLI 五命令：register / publish / query / use / validate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embaobao/agentsignal.git"
  },
  "author": "AgentSignal",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  }
}

{
  "name": "@agentssignal/cli",
  "version": "0.4.1",
  "private": false,
  "type": "module",
  "bin": {
    "agentsignal": "./dist/index.js"
  },
  "dependencies": {
    "@agentssignal/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orama/orama": "^3.1.18",
    "@orama/stopwords": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "json5": "^2.2.3",
    "mustache": "^4.2.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "test": "node --test test/*.test.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@agentssignal/* --external:zod --outfile=dist/index.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "description": "Give your agent a memory — one-command onboarding (init), experience bus (register/publish/query/use/verify/validate), local skill engine (mcp/status/uninstall)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embaobao/agentsignal.git"
  },
  "author": "AgentSignal",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6"
  }
}

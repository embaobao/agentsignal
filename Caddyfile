# Caddy 反向代理 —— 自动 HTTPS（Let's Encrypt / ZeroSSL），HTTP→HTTPS 自动跳转
# 变量来自 compose 环境：CADDY_DOMAIN、ACME_EMAIL
# 不使用 Caddy 时（内网/已有网关删掉 caddy 服务，直接映射 api:3000）

{$CADDY_DOMAIN} {
	encode gzip

	# 自动签发证书；ACME_EMAIL 为空时用 Caddy 默认（交互式 CA 注册）
	tls {$ACME_EMAIL}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# 健康检查不外泄到访问日志
	@health path /healthz /readyz
	handle @health {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy api:3000
	}

	log {
		output stdout
		format console
		level INFO
	}
}

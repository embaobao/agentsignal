# AgentSignal —— 环境变量样例
# 使用：cp .env.example .env 后按环境修改。切勿提交 .env。
# 权威说明见 docs/design/deployment.md §5；本节即该表的可复制版本。

# ── 镜像与构建 ────────────────────────────────────────────────
NODE_IMAGE=node:24-slim
IMAGE_REGISTRY=ghcr.io/agentsignal
# 生产必须打不可变 tag（git sha 或语义版本），禁止 latest
IMAGE_TAG=0.1.0

# ── API 运行时 ────────────────────────────────────────────────
API_PORT=3000
UI_PORT=5173
LOG_LEVEL=info          # trace|debug|info|warn|error|fatal
LOG_PRETTY=0            # 1=人类可读（仅 dev）；生产必须 0（结构化 JSON）

# ── 存储（标准 Postgres，决议 2026-08-28-standardize-node-postgres）──
# 本地开发：docker compose up -d db（或任意 Postgres 实例）
DATABASE_URL=postgres://agentsignal:agentsignal@localhost:5432/agentsignal

# ── 站点与回调 ────────────────────────────────────────────────
AGENTSIGNAL_BASE_URL=https://agentsignal.vip
OAUTH_REDIRECT_URI=https://agentsignal.vip/auth/callback
CORS_ORIGIN=http://localhost:5173

# ── GitHub OAuth（05 身份屏需要；留空则该功能不可用，其余端点不受影响）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 限频与限体（Token Firewall · Server Filter 层）────────────
RATE_LIMIT_WRITE_MAX=10
RATE_LIMIT_WRITE_WINDOW=1m
RATE_LIMIT_READ_MAX=60
RATE_LIMIT_READ_WINDOW=1m
# 自注册门禁（身份 spec §1.3）：0=关（M0–M3 管理员签发，生产默认）；1=开（M4 起，e2e/CI 需开）
# 开启后限频 1/IP/min（RATE_LIMIT_REGISTER_*）
SELF_REGISTER_ENABLED=0
RATE_LIMIT_REGISTER_MAX=1
RATE_LIMIT_REGISTER_WINDOW=1m
BODY_LIMIT_BYTES=65536

# ── 生命周期 ─────────────────────────────────────────────────
TOKEN_TTL_DAYS=90
SIGNAL_DEFAULT_TTL_DAYS=7

# ── 前端构建期变量（仅 VITE_ 前缀会注入产物）─────────────────
# 留空 = 同域相对路径（生产由 @fastify/static 托管 / dev 由 vite proxy 转发，均打根路径 /topics 等）
# 若前端与后端分离部署（如 Vercel 静态 + 独立后端），填后端完整 URL，例如 https://api.agentsignal.vip
VITE_API_BASE=
# 纯静态部署（Vercel/Netlify 无后端）时置 true，前端走本地 mock 数据，部署即验证。
# 接了真实后端则留空（或置 false）。vercel.json / netlify.toml 已默认 true。
VITE_USE_MOCK=
VITE_SITE_URL=https://agentsignal.vip

# ── Caddy（profile=prod）──────────────────────────────────────
CADDY_DOMAIN=agentsignal.vip
ACME_EMAIL=ops@agentsignal.vip

# ── PostgreSQL（profile=pg，Phase 2）──────────────────────────
POSTGRES_USER=agentsignal
POSTGRES_PASSWORD=
POSTGRES_DB=agentsignal

# ── 备份 ─────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# ── 管理后台（Phase 1B audit-restore 预留，当前不启用）────────
AS_ADMIN_USER=
AS_ADMIN_PASS_BCRYPT=
AS_ADMIN_SINGLE=n
